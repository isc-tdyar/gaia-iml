    ; rlm-core first: the Gaia classes extend RLM.Source.Table and RLM.LLM, so
    ; load order is not cosmetic -- src/ will not compile without the library
    ; already present. Submodule; a plain clone leaves lib/rlm-core empty.
    do $System.OBJ.LoadDir("/home/irisowner/dev/lib/rlm-core/src","ck",,1)

    ; compile RunScript.mac plus the Gaia.Analyst / Gaia.RLM AI Hub agent classes
    ; (LoadDir skips .mac routines, so load each entry point explicitly)
    do $System.OBJ.LoadDir("/home/irisowner/dev/src","ck",,1)
    do $System.OBJ.Load("/home/irisowner/dev/src/RunScript.mac","ck")
    do $System.OBJ.Load("/home/irisowner/dev/src/Analyze.mac","ck")
    do $System.OBJ.Load("/home/irisowner/dev/src/RLMAudit.mac","ck")
    do $System.OBJ.Load("/home/irisowner/dev/src/RLMTriage.mac","ck")
    do $System.OBJ.Load("/home/irisowner/dev/src/RLM2Audit.mac","ck")

    ;disabling password expire for development purposes
    zn "%SYS"
    Do ##class(Security.Users).UnExpireUserPasswords("*")

    ; enabling callin for Embedded Python
    do ##class(Security.Services).Get("%Service_CallIn",.prop)
    set prop("Enabled")=1
    set prop("AutheEnabled")=48
    do ##class(Security.Services).Modify("%Service_CallIn",.prop)
    halt
